# Frontend environment (Vite). Copy to `.env` for local dev.
# The frontend NEVER holds API keys — it only calls our own backend.

# Base URL of the Lumen FastAPI backend API (with /api/v1 prefix).
# In dev you can leave this as the proxied path "/api/v1" (see vite.config.ts),
# or point directly at a running backend, e.g. http://127.0.0.1:8099/api/v1
VITE_API_BASE=/api/v1

# Start in mock mode (no backend needed) when set to "1".
VITE_START_MOCK=0

# Dev-only: where Vite proxies /api during `npm run dev`.
VITE_PROXY_TARGET=http://127.0.0.1:8099
